# Copy to .env for local use. On Render set these under Environment.
# NEVER put real values in this file — this repository is public.

# --- Security -------------------------------------------------------------
# Shared key the Android app sends with every request (x-api-key header / socket auth).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match `api.key` in the app's local.properties.
API_KEY=

# "true" = reject callers without the key. Leave unset while rolling out: requests
# without a key are then only logged ("[auth-report]" lines) so you can confirm every
# client sends it. Switch to true once both phones run the new app.
ENFORCE_API_KEY=

# Protects POST /api/admin/publish-update (publishing app updates). Use a long random value.
# If unset, publishing is disabled.
ADMIN_SECRET=

# --- Infrastructure -------------------------------------------------------
MONGO_URI=
SERVICE_ACCOUNT_BASE64=      # base64 of the Firebase service-account JSON
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
